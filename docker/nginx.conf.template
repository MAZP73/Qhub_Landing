server {
  listen 80;
  root /usr/share/nginx/html;
  index index.html;
  server_tokens off;                                   # no anuncia la versión del servidor
  gzip on;
  gzip_types text/css application/javascript application/json image/svg+xml;
  add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;
  add_header Cross-Origin-Opener-Policy same-origin always;
  add_header X-Content-Type-Options nosniff always;
  add_header Referrer-Policy strict-origin-when-cross-origin always;
  add_header X-Frame-Options DENY always;
  add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ${API_ORIGIN}; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
  # `expires` (y no add_header) para no anular las cabeceras de seguridad de arriba: en nginx, un add_header dentro de un location descarta los del servidor.
  location /assets/ { expires 1y; }
  location / { try_files $uri /index.html; expires -1; }
}
